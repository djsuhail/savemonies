<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Luxury Women's Fashion Comparison</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            background-color: #f5f5f5;
            color: #333;
            margin: 0;
            padding: 0;
        }
        .container {
            width: 90%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px 0;
        }
        header {
            background-color: #e0e0e0;
            padding: 20px 0;
            text-align: center;
            margin-bottom: 30px;
        }
        h1, h2 {
            color: #555;
        }
        .comparison-section {
            background-color: white;
            padding: 20px;
            margin-bottom: 30px;
            border-radius: 5px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        .products {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            gap: 20px;
        }
        .product-card {
            width: calc(33.33% - 20px);
            background-color: #fafafa;
            border: 1px solid #ddd;
            border-radius: 5px;
            padding: 15px;
            box-sizing: border-box;
        }
        .product-image {
            width: 100%;
            height: 200px;
            background-color: #eee;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #999;
        }
        .product-title {
            font-weight: bold;
            margin-bottom: 10px;
            color: #444;
        }
        .price-comparison {
            display: flex;
            justify-content: space-between;
            margin-top: 10px;
            padding-top: 10px;
            border-top: 1px dashed #ccc;
        }
        .price {
            text-align: center;
        }
        .price-amount {
            font-weight: bold;
        }
        .price-site {
            font-size: 0.8em;
            color: #777;
        }
        .highlight {
            color: #d32f2f;
            font-weight: bold;
        }
        .section-title {
            border-bottom: 2px solid #ddd;
            padding-bottom: 10px;
            margin-bottom: 20px;
        }
        @media (max-width: 768px) {
            .product-card {
                width: calc(50% - 15px);
            }
        }
        @media (max-width: 480px) {
            .product-card {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <header>
        <div class="container">
            <h1>Luxury Women's Fashion Comparison</h1>
        </div>
    </header>

    <div class="container">
        <section class="comparison-section">
            <h2 class="section-title">Women's Tops - Price Comparison</h2>
            <div class="products">
                <!-- Product 1 -->
                <div class="product-card">
                    <div class="product-image">Silk Blouse Image</div>
                    <div class="product-title">Designer Silk Blouse</div>
                    <div class="price-comparison">
                        <div class="price">
                            <div class="price-amount">$295</div>
                            <div class="price-site">Nordstrom</div>
                        </div>
                        <div class="price">
                            <div class="price-amount highlight">$225</div>
                            <div class="price-site">Saks Off 5th</div>
                        </div>
                        <div class="price">
                            <div class="price-amount">$275</div>
                            <div class="price-site">Bloomingdale's</div>
                        </div>
                    </div>
                </div>

                <!-- Product 2 -->
                <div class="product-card">
                    <div class="product-image">Cashmere Sweater Image</div>
                    <div class="product-title">Luxury Cashmere Sweater</div>
                    <div class="price-comparison">
                        <div class="price">
                            <div class="price-amount">$450</div>
                            <div class="price-site">Neiman Marcus</div>
                        </div>
                        <div class="price">
                            <div class="price-amount highlight">$380</div>
                            <div class="price-site">Farfetch</div>
                        </div>
                        <div class="price">
                            <div class="price-amount">$425</div>
                            <div class="price-site">Bergdorf Goodman</div>
                        </div>
                    </div>
                </div>

                <!-- Product 3 -->
                <div class="product-card">
                    <div class="product-image">Lace Top Image</div>
                    <div class="product-title">Designer Lace Top</div>
                    <div class="price-comparison">
                        <div class="price">
                            <div class="price-amount">$320</div>
                            <div class="price-site">Saks Fifth Ave</div>
                        </div>
                        <div class="price">
                            <div class="price-amount">$315</div>
                            <div class="price-site">Mytheresa</div>
                        </div>
                        <div class="price">
                            <div class="price-amount highlight">$285</div>
                            <div class="price-site">MatchesFashion</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="comparison-section">
            <h2 class="section-title">Women's Dresses ($2000-$5000 Range)</h2>
            <div class="products">
                <!-- Dress 1 -->
                <div class="product-card">
                    <div class="product-image">Evening Gown Image</div>
                    <div class="product-title">Designer Evening Gown</div>
                    <div class="price-comparison">
                        <div class="price">
                            <div class="price-amount">$3,200</div>
                            <div class="price-site">Bergdorf Goodman</div>
                        </div>
                        <div class="price">
                            <div class="price-amount highlight">$2,850</div>
                            <div class="price-site">Farfetch</div>
                        </div>
                        <div class="price">
                            <div class="price-amount">$3,150</div>
                            <div class="price-site">Moda Operandi</div>
                        </div>
                    </div>
                </div>

                <!-- Dress 2 -->
                <div class="product-card">
                    <div class="product-image">Wedding Dress Image</div>
                    <div class="product-title">Luxury Wedding Dress</div>
                    <div class="price-comparison">
                        <div class="price">
                            <div class="price-amount highlight">$4,200</div>
                            <div class="price-site">Kleinfeld</div>
                        </div>
                        <div class="price">
                            <div class="price-amount">$4,500</div>
                            <div class="price-site">Vera Wang</div>
                        </div>
                        <div class="price">
                            <div class="price-amount">$4,750</div>
                            <div class="price-site">Pronovias</div>
                        </div>
                    </div>
                </div>

                <!-- Dress 3 -->
                <div class="product-card">
                    <div class="product-image">Couture Dress Image</div>
                    <div class="product-title">Haute Couture Dress</div>
                    <div class="price-comparison">
                        <div class="price">
                            <div class="price-amount">$4,800</div>
                            <div class="price-site">Chanel</div>
                        </div>
                        <div class="price">
                            <div class="price-amount highlight">$4,250</div>
                            <div class="price-site">Net-a-Porter</div>
                        </div>
                        <div class="price">
                            <div class="price-amount">$4,600</div>
                            <div class="price-site">Dior</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</body>
</html>
